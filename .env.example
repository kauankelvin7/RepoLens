# Optional: raises GitHub API limits for public repository analysis.
# Use a fine-grained token with the smallest permissions possible.
GITHUB_TOKEN=

# GitHub App settings. Required only for installations/private repositories.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=
