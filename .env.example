# Optional: raises GitHub API limits for public repository analysis only.
# Use a fine-grained token that cannot read private repositories.
GITHUB_TOKEN=

# GitHub App settings for installation authentication and signed webhooks.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=
